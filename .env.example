# Demo uses no keys. Real visual classification uses OpenAI Decisions.
OPENAI_API_KEY=
ANALYSIS_PROVIDER=openai
# Optional legacy transcript-only Jev provider: ANALYSIS_PROVIDER=jev
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
# Optional: collect from Meta instead of importing files
APIFY_TOKEN=
# Optional: transcribe video uploads; choose fireworks or groq
TRANSCRIPTION_PROVIDER=fireworks
FIREWORKS_API_KEY=
GROQ_API_KEY=
# Optional: generate original briefs using an OpenAI-compatible chat API.
# Without these, the app produces clearly labeled editable brief outlines.
LLM_BASE_URL=https://api.fireworks.ai/inference/v1
LLM_API_KEY=
LLM_MODEL=
PORT=5194
